// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  quotes      Quote[]
  backgrounds Background[]
  activePage  UserActivePage?
}

model FacebookPage {
  id          String   @id @default(cuid())
  name        String   // Facebook page name
  description String?  // Optional description
  pageId      String?  // Optional Facebook Page ID for API integration
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  quotes       Quote[]
  backgrounds  Background[]
  activeUsers  UserActivePage[]
  
  @@index([isActive])
}

model Quote {
  id            String       @id @default(cuid())
  text          String
  author        String?
  category      String?
  generatedBy   String?      // Model used for generation
  
  // Facebook Page relation
  facebookPageId String
  facebookPage   FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
  
  // User relation (who created it)
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  @@index([facebookPageId])
  @@index([createdById])
  @@index([createdAt])
}

model Background {
  id            String       @id @default(cuid())
  prompt        String
  imageUrl      String?      // Stored image path/URL
  generatedBy   String?      // Model used for generation
  aspectRatio   String?      // e.g., "3:4", "16:9"
  
  // Facebook Page relation
  facebookPageId String
  facebookPage   FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
  
  // User relation (who created it)
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  @@index([facebookPageId])
  @@index([createdById])
  @@index([createdAt])
}

model RegistrationRequest {
  id          String             @id @default(cuid())
  email       String             @unique
  password    String
  name        String?
  status      RegistrationStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// Model for storing Gemini text generation models
model TextModel {
  id          String   @id @default(cuid())
  name        String   // Display name
  modelId     String   @unique // Actual model ID used in API calls
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Model for storing Gemini image generation models
model ImageModel {
  id          String   @id @default(cuid())
  name        String   // Display name
  modelId     String   @unique // Actual model ID used in API calls
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Model for storing image generation settings
model ImageSettings {
  id                String   @id @default(cuid())
  defaultAspectRatio String  @default("3:4")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Model for storing layout/UI settings
model LayoutSettings {
  id                    String   @id @default(cuid())
  // Navigation visibility settings
  showGenerateContent   Boolean  @default(true)
  showViewContent       Boolean  @default(true)
  showUploadContent     Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Model for storing user's active Facebook Page selection
model UserActivePage {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  facebookPageId  String
  facebookPage    FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([userId])
  @@index([facebookPageId])
}
